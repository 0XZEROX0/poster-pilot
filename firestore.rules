rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone may sign in with Google, but only people in `members` can see or change anything.
    // A person gets in by typing the system code, which only files a request; an owner or admin
    // then accepts it. The owner can do everything. Everyone else has one role, and a role is a
    // list of permissions the owner ticks (roles/{id}): what a person may do is checked here.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }
    function isMember() {
      return signedIn() && exists(memberPath(request.auth.uid));
    }
    function myRole() {
      return get(memberPath(request.auth.uid)).data.role;
    }
    function isOwner() {
      return isMember() && myRole() == 'owner';
    }
    function allPerms() {
      return ['offers.view', 'offers.create', 'offers.approve', 'designs.approve', 'fix', 'schedule', 'delete', 'people', 'prices.edit', 'cost', 'quotes.all', 'quotes.discount', 'quotes.edit', 'templates.edit', 'activity.view', 'brainstorm', 'prices.web', 'tickets', 'tickets.edit', 'social.delete', 'orders', 'orders.edit', 'orders.change', 'orders.delete'];
    }
    function rolePath(role) {
      return /databases/$(database)/documents/roles/$(role);
    }
    // 'admin' and 'member' work as they always did until the owner saves them as roles.
    function permsOf(role) {
      return role == 'owner' ? allPerms()
        : exists(rolePath(role)) ? get(rolePath(role)).data.perms
        : role == 'admin' ? allPerms()
        : role == 'member' ? ['offers.view', 'offers.create', 'offers.approve', 'designs.approve', 'fix', 'schedule', 'delete', 'prices.edit', 'templates.edit', 'brainstorm', 'tickets']
        : [];
    }
    // Pages a role is shown. A role only reads the posts that belong to its pages: every post carries
    // a `zone` (offer, design, fix, approved, posted) that the engine keeps up to date.
    function allPages() {
      return ['offers', 'review', 'fix', 'calendar', 'posted', 'database'];
    }
    function myPages() {
      let role = myRole();
      return role == 'owner' || !exists(rolePath(role)) ? allPages() : get(rolePath(role)).data.get('pages', allPages());
    }
    function zonesOf(pg) {
      return (('offers' in pg) ? ['offer'] : [])
        .concat(('review' in pg || 'database' in pg) ? ['design'] : [])
        .concat(('review' in pg || 'fix' in pg || 'database' in pg) ? ['fix'] : [])
        .concat(('calendar' in pg || 'database' in pg) ? ['approved'] : [])
        .concat(('calendar' in pg || 'posted' in pg || 'database' in pg) ? ['posted'] : []);
    }
    function mayReadPost() {
      let pg = myPages();
      return pg.hasAll(allPages()) || resource.data.zone in zonesOf(pg);
    }
    // Someone who may only look (for example 'See offers') cannot change a post in any way.
    function canAct() {
      return isMember() && permsOf(myRole()).hasAny(['offers.create', 'offers.approve', 'designs.approve', 'fix', 'schedule', 'delete', 'social.delete']);
    }
    function can(perm) {
      return isMember() && perm in permsOf(myRole());
    }
    function isAdmin() {
      return can('people');
    }
    // Who may set which Feedback. Taking a post off the schedule belongs to scheduling. Text, photo and video
    // posts (`custom`) are made and approved in the Planner, by the people who schedule.
    function feedbackOk(value, was, custom) {
      return (custom && (can('schedule') || can('designs.approve')))
        || (value == 'Cancel' ? can('schedule')
          : (value == 'Done' && was == 'Cancel') ? (can('schedule') || can('designs.approve'))
          : value in ['Redo', 'Redo next image'] ? (can('designs.approve') || can('fix') || can('offers.create'))
          : can('designs.approve'));
    }
    // Text, photo and video posts (`kind`): the kind is set when the post is made and never changes; up to 10
    // uploaded files (Drive ids); where it goes. A text post goes to Facebook only.
    function customOk(d) {
      return (!('kind' in d) || d.kind in ['text', 'image', 'video'])
        && (!('media' in d) || (d.media is list && d.media.size() <= 10))
        && (!('places' in d) || (d.places in ['fb+ig', 'fb', 'ig'] && (d.get('kind', '') != 'text' || d.places == 'fb')));
    }
    // A change to a post, field by field. `appEdits` is the copy of the change that the engine
    // carries to the sheet, so it is held to the same rules.
    function postChangeOk() {
      let now = request.resource.data;
      let was = resource.data;
      let edits = now.get('appEdits', {});
      let sent = edits.diff(was.get('appEdits', {}));
      let keys = now.diff(was).affectedKeys().union(sent.addedKeys()).union(sent.changedKeys());
      return (!keys.hasAny(['postDate', 'postTime']) || can('schedule'))
        // "Post now" publishes on Facebook and Instagram at once: only someone who may schedule can ask for it.
        && (!keys.hasAny(['postNow']) || can('schedule'))
        // Also posting it as a story (where, and how long after the post) belongs to scheduling too.
        && (!keys.hasAny(['story', 'storyDelay', 'storyDesign']) || can('schedule'))
        && (!keys.hasAny(['feedback']) || (feedbackOk(now.get('feedback', ''), was.get('feedback', ''), was.get('kind', '') != '') && feedbackOk(edits.get('feedback', now.get('feedback', '')), was.get('feedback', ''), was.get('kind', '') != '')))
        && (!keys.hasAny(['appDeleted']) || can('delete'))
        // "Delete from Facebook and Instagram" takes a published post off the Page and Instagram for good: only with
        // its own permission, only as a new ask ('asked', with the time and the name of who asked), and only once
        // (again only after the engine reported that it failed).
        && (!keys.hasAny(['takeDown', 'takeDownAt', 'takeDownBy'])
          || (can('social.delete') && now.get('takeDown', '') == 'asked' && was.get('takeDown', '') in ['', 'failed']
            && now.get('takeDownAt', 0) is int && now.get('takeDownBy', '') is string && now.get('takeDownBy', '').size() <= 200
            && was.get('fbStatus', '') == 'Published'))
        && (!keys.hasAny(['ignoredProblem']) || can('fix'))
        // Asking for the website photos of the items, for the photo picker.
        && (!keys.hasAny(['photoAsk']) || can('offers.create') || can('fix') || can('designs.approve'))
        && (!keys.hasAny(['items', 'variants', 'title', 'company', 'priceBefore', 'priceAfter', 'style', 'details', 'caption', 'captionStyle', 'media', 'places']) || can('offers.create') || can('fix') || can('designs.approve') || (was.get('kind', '') != '' && can('schedule')))
        && customOk(now) && customOk(edits)
        // An offer is approved by someone other than the person who made it. The owner always may.
        && (!keys.hasAny(['offer', 'offerNote', 'offerBy'])
          || (can('offers.approve') && (isOwner() || isAdmin() || was.get('createdBy', '') != request.auth.uid))
          // The maker may send an offer that was sent back in again, and nothing else.
          || (can('offers.create') && was.get('createdBy', '') == request.auth.uid && was.get('offer', '') == 'Rejected'
            && now.get('offer', '') == '' && edits.get('offer', '') == '' && !keys.hasAny(['offerNote', 'offerBy'])))
        // Competitor prices, where a post stands, and what Facebook and the poster maker report are written by the engine only.
        && !keys.hasAny(['kind', 'createdBy', 'createdByName', 'market', 'photoChoices', 'zone', 'order', 'createdAt', 'posterUrl', 'photoStatus', 'scheduledFor', 'fbStatus', 'igStatus', 'fbPostId', 'appNew', 'storyImage', 'storyFbStatus', 'storyIgStatus', 'storyDesignedAt', 'storyVideo', 'takeDownNote', 'takeDownTry']);
    }
    // The first list from before codes existed. Its first email is the owner; the others may
    // walk in once without a request. Admins can only shorten it.
    function firstList() {
      return get(/databases/$(database)/documents/config/access).data.emails;
    }
    function currentCode() {
      return get(/databases/$(database)/documents/secret/code).data.code;
    }
    function secretPath() {
      return /databases/$(database)/documents/secret/code;
    }
    // A request can only be filed with the code that is valid at that moment, so a request that
    // exists was made by someone who had the code. It stops counting after 7 days, or when the
    // owner makes a new code by hand. Accepting it must change the code in the same step, so a
    // code lets exactly one new person in and cannot be passed on.
    function goodRequest(uid) {
      let r = get(/databases/$(database)/documents/requests/$(uid)).data;
      let s = get(secretPath()).data;
      return r.createdAt > request.time - duration.value(7, 'd')
        && (!('resetAt' in s) || r.createdAt > s.resetAt)
        && r.email == request.resource.data.email
        && getAfter(secretPath()).data.code != s.code;
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'joinedAt'])
        && request.resource.data.email is string
        && (
          // Yourself, from the first list.
          (request.auth.uid == uid
            && request.resource.data.email == request.auth.token.email
            && ((request.resource.data.role == 'owner' && firstList()[0] == request.auth.token.email)
              || (request.resource.data.role == 'member' && request.auth.token.email in firstList())))
          // Someone else, by accepting their request.
          || (request.auth.uid != uid && isAdmin() && request.resource.data.role == 'member' && goodRequest(uid))
        );
      // Only the owner changes roles, never their own, and nobody becomes a second owner.
      allow update: if isOwner()
        && request.auth.uid != uid
        && resource.data.role != 'owner'
        && request.resource.data.role is string
        && request.resource.data.role != 'owner'
        && (request.resource.data.role in ['admin', 'member'] || exists(rolePath(request.resource.data.role)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      allow delete: if signedIn() && resource.data.role != 'owner'
        // Someone who manages people cannot remove another person who manages people.
        && (request.auth.uid == uid || isOwner() || (isAdmin() && !('people' in permsOf(resource.data.role))));
    }

    // Each person's picture (Google's, or a small one they chose), shown next to their name to everyone inside.
    match /profiles/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'custom', 'nameCustom', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.photo is string && request.resource.data.photo.size() < 60000
        && (request.resource.data.photo == ''
          || request.resource.data.photo.matches('https://[^ ]+')
          || request.resource.data.photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
        && request.resource.data.custom is bool
        && (!('nameCustom' in request.resource.data) || request.resource.data.nameCustom is bool);
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
    }

    match /requests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // The code is checked here, on the server, so a wrong code cannot even file a request.
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'code', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.code == currentCode();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /secret/code {
      allow read: if isAdmin();
      // The owner makes a new code by hand, which also drops the requests still waiting.
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['code', 'changedAt', 'resetAt', 'lastJoin'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 16
        && (!('resetAt' in request.resource.data) || request.resource.data.resetAt is timestamp);
      // Someone who manages people can change the code only as part of accepting a new person.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code', 'changedAt', 'lastJoin'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 16
        && request.resource.data.code != resource.data.code
        && request.resource.data.lastJoin is string
        && !exists(memberPath(request.resource.data.lastJoin))
        && existsAfter(memberPath(request.resource.data.lastJoin));
    }

    match /config/access {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emails'])
        && request.resource.data.emails.size() >= 1
        && request.resource.data.emails.size() <= resource.data.emails.size()
        && request.resource.data.emails[0] == resource.data.emails[0]
        && resource.data.emails.hasAll(request.resource.data.emails);
    }
    // The roles the owner made. Everyone inside reads them to know what they may do.
    match /roles/{id} {
      allow read: if isMember();
      allow create, update: if isOwner()
        && id != 'owner'
        && request.resource.data.keys().hasOnly(['name', 'perms', 'pages', 'v'])
        && (!('v' in request.resource.data) || request.resource.data.v is int)
        && (!('pages' in request.resource.data) || (request.resource.data.pages is list
          && request.resource.data.pages.hasOnly(['prices', 'builder', 'offers', 'review', 'fix', 'calendar', 'posted', 'database'])))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.perms is list
        && request.resource.data.perms.size() <= 40
        && request.resource.data.perms.hasOnly(allPerms());
      allow delete: if isOwner() && !(id in ['admin', 'member']);
    }
    match /posts/{id} {
      allow read: if isMember() && mayReadPost();
      // A new post always starts as an offer waiting for approval: nothing approved, scheduled or posted.
      // Text, photo and video posts (`kind`) are made in the Planner, only by the people who schedule.
      allow create: if (request.resource.data.get('kind', '') != '' ? can('schedule') : can('offers.create'))
        && request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid
        && request.resource.data.get('zone', 'offer') == 'offer'
        && request.resource.data.get('feedback', '') == ''
        && request.resource.data.get('postDate', '') == '' && request.resource.data.get('postTime', '') == ''
        && request.resource.data.get('fbStatus', '') == '' && request.resource.data.get('igStatus', '') == '' && request.resource.data.get('fbPostId', '') == ''
        && request.resource.data.get('scheduledFor', '') == '' && request.resource.data.get('posterUrl', '') == ''
        && !request.resource.data.keys().hasAny(['offer', 'offerNote', 'offerBy', 'market', 'photoChoices', 'appDeleted', 'ignoredProblem'])
        && customOk(request.resource.data);
      allow update: if canAct() && postChangeOk();
    }
    // The history of every post. The app adds a line with each change, in the same step, under the
    // person's own id and the server's time; nobody can change or remove a line afterwards. The
    // engine writes the sheet and workflow lines with its service account.
    match /log/{id} {
      allow read: if isMember();
      allow create: if canAct()
        && request.resource.data.keys().hasOnly(['postId', 'at', 'by', 'byName', 'act', 'note', 'changes', 'title'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.postId is string && request.resource.data.postId.size() > 0 && request.resource.data.postId.size() <= 40
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 200
        && request.resource.data.act in ['created', 'edited', 'offer.approved', 'offer.rejected', 'offer.resubmitted', 'design.approved', 'design.redo', 'design.redo_next',
          'design.skipped', 'design.back', 'schedule.set', 'schedule.cleared', 'schedule.cancel', 'schedule.postnow', 'problem.ignored', 'prices.recheck', 'deleted', 'social.delete']
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 1000))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 300))
        && (!('changes' in request.resource.data) || (request.resource.data.changes is list && request.resource.data.changes.size() <= 12));
      allow update, delete: if false;
    }
    // The activity log of the whole app: everything that has no history of its own above (Builder quotes,
    // discounts and live edits, people and roles, settings, engine runs). Read on the Activity page together
    // with log/ and priceLog/. A person adds a line under their own id and the server's time, only for what
    // their role may do; nobody, the owner included, can change or remove a line. The engine and the website
    // sync write their lines ('system', 'website') with their service account.
    function activityOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['at', 'by', 'byName', 'app', 'act', 'what', 'note', 'ref'])
        && d.by == request.auth.uid
        && d.at == request.time
        && d.byName is string && d.byName.size() <= 200
        && (!('what' in d) || (d.what is string && d.what.size() <= 300))
        && (!('note' in d) || (d.note is string && d.note.size() <= 1000))
        && (!('ref' in d) || (d.ref is string && d.ref.size() <= 80))
        && ((d.app == 'builder' && (d.act in ['quote.saved', 'quote.updated', 'quote.deleted']
              || (d.act in ['quote.discount', 'quote.discount_removed'] && can('quotes.discount'))
              || (d.act == 'quote.live_edit' && can('quotes.edit'))))
          || (d.app == 'people' && ((d.act in ['join.accepted', 'join.declined', 'member.removed'] && isAdmin())
              || (d.act in ['member.role', 'role.saved', 'role.deleted', 'code.reset'] && isOwner())))
          || (d.app == 'settings' && ((d.act == 'templates.saved' && can('templates.edit')) || d.act == 'engine.run'))
          || (d.app == 'tickets' && ((d.act == 'ticket.opened' && can('tickets')) || (d.act in ['ticket.step', 'ticket.edited'] && can('tickets.edit'))
              || (d.act in ['ticket.deleted', 'ticket.step_removed'] && isOwner())))
          || (d.app == 'orders' && ((d.act in ['order.step', 'order.added', 'order.edited'] && can('orders.edit')) || (d.act == 'order.edited' && can('orders.change'))
              || (d.act == 'order.deleted' && (isOwner() || can('orders.delete'))) || (d.act == 'order.step_removed' && isOwner()))));
    }
    match /activity/{id} {
      allow read: if can('activity.view');
      allow create: if isMember() && activityOk();
      allow update, delete: if false;
    }
    // The price list: one document per category (items keyed by product id) and prices/_meta, whose
    // version goes up with every change. Everyone inside reads it; changing it needs 'Edit prices'.
    // Every change comes with a line in priceLog, which nobody can change or remove afterwards.
    match /prices/{cat} {
      allow read: if isMember();
      allow create, update: if can('prices.edit') && (cat == '_meta'
        ? request.resource.data.keys().hasOnly(['version', 'at']) && request.resource.data.version is int
        : request.resource.data.keys().hasOnly(['name', 'order', 'items', 'importedAt']) && request.resource.data.items is map);
      allow delete: if false;
    }
    // What each product costs the shop. Kept apart from prices/* (which everyone inside, the engine and the website
    // sync read) so that only roles with 'See and edit cost' can read it at all. costs/{category} { items: { [productId]: { cost, at, byName } } }.
    match /costs/{cat} {
      allow read: if can('cost');
      allow create, update: if can('cost')
        && cat.size() <= 40 && cat != '_meta'
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is map;
      allow delete: if false;
    }
    // What the lines of completed orders cost the shop (typed in on the Sales page), one document per month the
    // orders were placed in: orderCosts/{YYYY-MM} { orders: { [orderId]: { lines: [{ n, c }], at, byName } } }.
    // Only 'See and edit cost'; kept out of orders/* because everyone handling orders reads those.
    match /orderCosts/{month} {
      allow read: if can('cost');
      // orderCosts/links { web: { 'websiteId:optionId': 'cat/pid' }, names: { [line name]: 'cat/pid' } }: the price
      // list product picked for every line of a website product or with a name.
      allow create, update: if can('cost')
        && ((month.matches('[0-9]{4}-[0-9]{2}')
            && request.resource.data.keys().hasOnly(['orders'])
            && request.resource.data.orders is map)
          || (month == 'links'
            && request.resource.data.keys().hasOnly(['web', 'names'])
            && request.resource.data.get('web', {}) is map
            && request.resource.data.get('names', {}) is map));
      allow delete: if false;
    }
    // Every cost change, like priceLog but only for those who may see cost. Nobody changes or removes a line.
    match /costLog/{id} {
      allow read: if can('cost');
      allow create: if can('cost')
        && request.resource.data.keys().hasOnly(['cat', 'pid', 'name', 'act', 'changes', 'at', 'by', 'byName'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.act == 'cost'
        && request.resource.data.cat is string && request.resource.data.cat.size() <= 40
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 400
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 200
        && request.resource.data.changes is list && request.resource.data.changes.size() <= 2;
      allow update, delete: if false;
    }
    // New offer, "Versions of one product": a person asks for every website photo of one product (one request each,
    // overwritten by the next). The engine answers in the same document with its service account.
    match /photoAsks/{uid} {
      allow read: if signedIn() && request.auth.uid == uid && isMember();
      allow create, update: if signedIn() && request.auth.uid == uid && can('offers.create')
        && request.resource.data.keys().hasOnly(['name', 'ask', 'by'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 300
        && request.resource.data.ask is int && request.resource.data.by == uid;
      allow delete: if false;
    }
    // What the engine read from static-eg.com (web/products: every website product, for linking by hand, and its
    // photos for the Builder). Public website information, so every member may read it.
    // Only the engine writes it.
    match /web/{id} {
      allow read: if isMember();
      allow write: if false;
    }
    match /priceLog/{id} {
      allow read: if isMember();
      allow create: if can('prices.edit')
        && request.resource.data.keys().hasOnly(['cat', 'pid', 'name', 'act', 'changes', 'at', 'by', 'byName'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.cat is string && request.resource.data.cat.size() <= 40
        && request.resource.data.pid is string && request.resource.data.pid.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 400
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 200
        && request.resource.data.act in ['edit', 'add', 'remove', 'bulk']
        && request.resource.data.changes is list && request.resource.data.changes.size() <= 12;
      allow update, delete: if false;
    }
    // Quotations made in the builder. Whoever made one (or the owner) changes or deletes it.
    function quoteOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['customer', 'sales', 'lines', 'extra', 'buildDiscount', 'total', 'at', 'by', 'byName'])
        && d.customer is string && d.customer.size() <= 120
        && d.sales is string && d.sales.size() <= 120
        && d.lines is list && d.lines.size() <= 40
        && d.extra is number && d.total is number && d.buildDiscount is bool
        && d.at == request.time
        && d.byName is string && d.byName.size() <= 200;
    }
    match /quotes/{id} {
      // Each person reads their own quotes; 'See all saved quotes' (and the owner) reads everyone's.
      allow read: if isMember() && (resource.data.by == request.auth.uid || can('quotes.all'));
      allow create: if isMember() && quoteOk() && request.resource.data.by == request.auth.uid;
      allow update: if isMember() && (resource.data.by == request.auth.uid || isOwner()) && quoteOk()
        && request.resource.data.by == resource.data.by && request.resource.data.byName == resource.data.byName;
      allow delete: if isMember() && (resource.data.by == request.auth.uid || isOwner());
    }
    // The build each person has open (drafts/{their uid}), shared as they work so it can be watched live.
    match /drafts/{uid} {
      allow read: if isMember() && (uid == request.auth.uid || can('quotes.all') || can('quotes.discount') || can('quotes.edit'));
      allow create, update: if isMember() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['customer', 'sales', 'lines', 'extra', 'grant', 'buildDiscount', 'total', 'at', 'byName'])
        && (!('grant' in request.resource.data) || request.resource.data.grant is number)
        && request.resource.data.customer is string && request.resource.data.customer.size() <= 120
        && request.resource.data.sales is string && request.resource.data.sales.size() <= 120
        && request.resource.data.lines is list && request.resource.data.lines.size() <= 40
        && request.resource.data.extra is number && request.resource.data.total is number && request.resource.data.buildDiscount is bool
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 200
        && request.resource.data.at == request.time;
      // Someone with 'Edit live quotes' changes the quote itself too, so the change shows at once and is kept
      // even while the person's app is closed. Who made the quote (sales, byName) and a given discount stay.
      allow update: if can('quotes.edit') && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customer', 'lines', 'extra', 'buildDiscount', 'total', 'at'])
        && request.resource.data.customer is string && request.resource.data.customer.size() <= 120
        && request.resource.data.lines is list && request.resource.data.lines.size() <= 40
        && request.resource.data.extra is number && request.resource.data.total is number && request.resource.data.buildDiscount is bool
        && request.resource.data.at == request.time;
      allow delete: if isMember() && uid == request.auth.uid;
    }
    // Changes someone with 'Edit live quotes' makes to another person's open quote; the builder's app takes them in.
    match /edits/{uid} {
      allow read: if isMember() && (uid == request.auth.uid || can('quotes.edit'));
      allow create, update: if can('quotes.edit')
        && request.resource.data.keys().hasOnly(['customer', 'lines', 'extra', 'buildDiscount', 'by', 'byName', 'at'])
        && request.resource.data.customer is string && request.resource.data.customer.size() <= 120
        && request.resource.data.lines is list && request.resource.data.lines.size() <= 40
        && request.resource.data.extra is number && request.resource.data.buildDiscount is bool
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 200
        && request.resource.data.at == request.time;
      allow delete: if isMember() && (uid == request.auth.uid || can('quotes.edit'));
    }
    // An extra discount someone with 'Give extra discount' puts on another person's open quote.
    match /grants/{uid} {
      allow read: if isMember() && (uid == request.auth.uid || can('quotes.all') || can('quotes.discount'));
      allow create, update: if can('quotes.discount')
        && request.resource.data.keys().hasOnly(['amount', 'by', 'byName', 'at'])
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 200
        && request.resource.data.at == request.time;
      allow delete: if isMember() && (uid == request.auth.uid || can('quotes.discount'));
    }
    // Products and styles come from the engine. Roles with 'Edit caption templates' may change the caption templates.
    // Brainstorm: a draft plan of which approved post could go out on which day, one document per week
    // (plans/{the Saturday it starts on}). It is only a plan: it never sets a post's date or time.
    match /plans/{week} {
      allow read: if can('brainstorm');
      allow create, update: if can('brainstorm')
        && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['days', 'at', 'by', 'byName'])
        && request.resource.data.days is map && request.resource.data.days.size() <= 7
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 200
        && request.resource.data.at == request.time;
      allow delete: if can('brainstorm');
    }
    // Maintenance: warranty and repair tickets, one document each with its whole event log inside
    // (tickets/T<no>). counters/tickets holds the last number; a new ticket must raise it by one in the same write.
    // 'Open maintenance tickets' sees and opens them; 'Edit maintenance tickets' changes them and adds steps.
    // Steps can only be added; only the owner may take a step out or delete a ticket.
    function ticketOk(d) {
      return d.keys().hasOnly(['no', 'customer', 'phone', 'product', 'productId', 'serial', 'problem', 'items', 'provider', 'providerRef', 'receivedOn', 'dueOn', 'closed', 'createdAt', 'createdBy', 'createdByName', 'updatedAt', 'steps'])
        && d.no is int
        && d.customer is string && d.customer.size() <= 120
        && d.phone is string && d.phone.size() <= 40
        && d.product is string && d.product.size() <= 300
        && d.productId is string && d.productId.size() <= 40
        && d.serial is string && d.serial.size() <= 120
        && d.problem is string && d.problem.size() <= 2000
        && d.items is string && d.items.size() <= 500
        && d.provider is string && d.provider.size() <= 120
        && d.providerRef is string && d.providerRef.size() <= 120
        && d.receivedOn is string && d.receivedOn.size() <= 10
        && d.dueOn is string && d.dueOn.size() <= 10
        && d.closed is bool
        && d.createdByName is string && d.createdByName.size() <= 200
        && d.steps is list && d.steps.size() <= 300
        && d.updatedAt == request.time;
    }
    match /tickets/{id} {
      allow read: if can('tickets') || can('tickets.edit');
      allow create: if (can('tickets') || can('tickets.edit')) && ticketOk(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && id == 'T' + string(request.resource.data.no)
        && getAfter(/databases/$(database)/documents/counters/tickets).data.n == request.resource.data.no;
      allow update: if can('tickets.edit') && ticketOk(request.resource.data)
        && request.resource.data.no == resource.data.no
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByName == resource.data.createdByName
        && (request.resource.data.steps.size() > resource.data.steps.size() || request.resource.data.steps == resource.data.steps || isOwner());
      allow delete: if isOwner();
    }
    // Website orders (orders/W<website order id>), one document each with its whole event log inside.
    // Only the engine makes them and writes the website part (customer, items, totals, website status), with its
    // service account. The app may change only what happens in the shop: the status and the website status to send
    // (want), the agreed price, the date and time, and the log. Steps can only be added; only the owner may take a
    // step out or remove an order from the app (it stays on the website).
    function orderStepOk(st) {
      return st is map && st.keys().hasOnly(['at', 'by', 'byName', 'kind', 'note', 'amount', 'method', 'date', 'time', 'web'])
        && st.kind in ['called', 'confirmed', 'date', 'price', 'paid', 'ready', 'out', 'delivered', 'cancelled', 'reopened', 'note', 'edited']
        && st.note is string && st.note.size() <= 1000
        && (!('amount' in st) || (st.amount is number && st.amount >= 0 && st.amount <= 100000000));
    }
    // Orders added by hand in the app (WhatsApp, phone, in the shop): orders/M<random>, same shape as a website
    // order, with source set and no website part (wooId 0, webStatus and want always empty: never sent anywhere).
    // People with 'Handle website orders' add them; 'Change order details' changes them later (with an "edited" step).
    function manualOrderOk(d) {
      return d.source in ['whatsapp', 'phone', 'callcenter', 'facebook', 'instagram', 'store', 'site', 'other']
        && orderTagsOk(d)
        && d.wooId == 0 && d.webStatus == '' && d.want == '' && d.webError == ''
        && d.number is string && d.number.size() <= 40
        && orderDetailsOk(d);
    }
    // The details anyone with 'Change order details' may change on any order (website orders: marked local and push).
    function orderDetailsOk(d) {
      return d.customer is string && d.customer.size() <= 200
        && d.phone is string && d.phone.size() <= 40
        && d.email is string && d.email.size() <= 200
        && d.address is string && d.address.size() <= 500
        && d.city is string && d.city.size() <= 120
        && d.area is string && d.area.size() <= 120
        && d.delivery in ['pickup', 'delivery']
        && d.shipping is number && d.shipping >= 0
        && d.payMethod is string && d.payMethod.size() <= 80
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 100
        && d.webTotal is number && d.webTotal >= 0
        && d.customerNote is string && d.customerNote.size() <= 2000;
    }
    // Who sold it and what kind of order it is (any order); the label and shipping state come only from the old sheet import.
    function orderTagsOk(d) {
      return d.get('rep', '') is string && d.get('rep', '').size() <= 80
        && d.get('category', '') is string && d.get('category', '').size() <= 80;
    }
    function orderDetailKeys() {
      return ['customer', 'phone', 'email', 'address', 'city', 'area', 'delivery', 'shipping', 'payMethod', 'items', 'webTotal', 'customerNote'];
    }
    function manualOrderKeys() {
      return ['source', 'wooId', 'number', 'webStatus', 'want', 'status', 'closed', 'placedAt', 'customer', 'phone', 'email', 'address', 'city', 'area',
        'delivery', 'shipping', 'payMethod', 'items', 'webTotal', 'agreed', 'customerNote', 'date', 'time', 'webError', 'updatedAt', 'steps'];
    }
    match /orders/{id} {
      allow read: if can('orders') || can('orders.edit') || can('orders.change') || can('orders.delete');
      allow create: if can('orders.edit')
        && id.matches('M[A-Za-z0-9]{8,40}')
        && request.resource.data.keys().hasOnly(manualOrderKeys().concat(['rep', 'category']))
        && request.resource.data.keys().hasAll(manualOrderKeys())
        && manualOrderOk(request.resource.data)
        && request.resource.data.status in ['new', 'confirmed']
        && request.resource.data.closed == false
        && (request.resource.data.agreed == null || (request.resource.data.agreed is number && request.resource.data.agreed >= 0))
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.time is string && request.resource.data.time.size() <= 5
        && request.resource.data.placedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.steps is list && request.resource.data.steps.size() == 1
        && request.resource.data.steps[0] is map
        && request.resource.data.steps[0].keys().hasOnly(['at', 'by', 'byName', 'kind', 'note'])
        && request.resource.data.steps[0].kind == 'placed'
        && request.resource.data.steps[0].by == request.auth.uid
        && request.resource.data.steps[0].note is string && request.resource.data.steps[0].note.size() <= 1000;
      // 'Handle website orders' moves an order on (status, date, price, payments, steps). 'Change order details' changes
      // what it holds (items, delivery, address, name, phone...), never its status; a website order changed that way is
      // marked local (the engine stops bringing the website's details over it) and push (the engine sends them to the website).
      allow update: if orderTagsOk(request.resource.data)
        && ((can('orders.edit')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'want', 'closed', 'agreed', 'date', 'time', 'steps', 'updatedAt', 'rep', 'category']))
          || (can('orders.change')
            && resource.data.get('source', 'website') in ['whatsapp', 'phone', 'callcenter', 'facebook', 'instagram', 'store', 'site', 'other']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreed', 'date', 'time', 'steps', 'updatedAt', 'rep', 'category', 'source'].concat(orderDetailKeys()))
            && manualOrderOk(request.resource.data))
          || (can('orders.change')
            && resource.data.get('source', 'website') == 'website'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreed', 'date', 'time', 'steps', 'updatedAt', 'rep', 'category', 'local', 'push'].concat(orderDetailKeys()))
            && request.resource.data.local == true
            && request.resource.data.get('push', false) == true
            && orderDetailsOk(request.resource.data)))
        && (resource.data.get('source', 'website') == 'website' || request.resource.data.want == '')
        && request.resource.data.status in ['new', 'confirmed', 'completed', 'cancelled', 'refunded', 'failed']
        && request.resource.data.want in ['', 'on-hold', 'processing', 'completed', 'cancelled']
        && request.resource.data.closed == !(request.resource.data.status in ['new', 'confirmed'])
        && (request.resource.data.agreed == null || (request.resource.data.agreed is number && request.resource.data.agreed >= 0))
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.time is string && request.resource.data.time.size() <= 5
        && request.resource.data.steps is list && request.resource.data.steps.size() <= 300
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.steps.size() == resource.data.steps.size() + 1
              && orderStepOk(request.resource.data.steps[request.resource.data.steps.size() - 1])
              && request.resource.data.steps[request.resource.data.steps.size() - 1].by == request.auth.uid)
          || isOwner());
      allow delete: if isOwner() || can('orders.delete');
    }
    match /counters/tickets {
      allow read: if can('tickets') || can('tickets.edit');
      allow create, update: if (can('tickets') || can('tickets.edit'))
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1
        && existsAfter(/databases/$(database)/documents/tickets/$('T' + string(request.resource.data.n)))
        && !exists(/databases/$(database)/documents/tickets/$('T' + string(request.resource.data.n)));
    }
    match /catalog/{id} {
      allow read: if isMember();
      allow create, update: if id == 'templates'
        && can('templates.edit')
        && request.resource.data.keys().hasOnly(['items', 'appEditedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 50;
    }
    match /status/{id} {
      allow read: if isMember();
    }
  }
}
