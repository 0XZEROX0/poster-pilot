rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone may sign in with Google, but only people in `members` can see or change anything.
    // A person gets in by typing the system code, which only files a request; an owner or admin
    // then accepts it. The owner can do everything. Everyone else has one role, and a role is a
    // list of permissions the owner ticks (roles/{id}): what a person may do is checked here.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }
    function isMember() {
      return signedIn() && exists(memberPath(request.auth.uid));
    }
    function myRole() {
      return get(memberPath(request.auth.uid)).data.role;
    }
    function isOwner() {
      return isMember() && myRole() == 'owner';
    }
    function allPerms() {
      return ['offers.create', 'offers.approve', 'designs.approve', 'fix', 'schedule', 'delete', 'people'];
    }
    function rolePath(role) {
      return /databases/$(database)/documents/roles/$(role);
    }
    // 'admin' and 'member' work as they always did until the owner saves them as roles.
    function permsOf(role) {
      return role == 'owner' ? allPerms()
        : exists(rolePath(role)) ? get(rolePath(role)).data.perms
        : role == 'admin' ? allPerms()
        : role == 'member' ? ['offers.create', 'offers.approve', 'designs.approve', 'fix', 'schedule', 'delete']
        : [];
    }
    function can(perm) {
      return isMember() && perm in permsOf(myRole());
    }
    function isAdmin() {
      return can('people');
    }
    // Who may set which Feedback. Taking a post off the schedule belongs to scheduling.
    function feedbackOk(value, was) {
      return value == 'Cancel' ? can('schedule')
        : (value == 'Done' && was == 'Cancel') ? (can('schedule') || can('designs.approve'))
        : value in ['Redo', 'Redo next image'] ? (can('designs.approve') || can('fix') || can('offers.create'))
        : can('designs.approve');
    }
    // A change to a post, field by field. `appEdits` is the copy of the change that the engine
    // carries to the sheet, so it is held to the same rules.
    function postChangeOk() {
      let now = request.resource.data;
      let was = resource.data;
      let edits = now.get('appEdits', {});
      let sent = edits.diff(was.get('appEdits', {}));
      let keys = now.diff(was).affectedKeys().union(sent.addedKeys()).union(sent.changedKeys());
      return (!keys.hasAny(['postDate', 'postTime']) || can('schedule'))
        && (!keys.hasAny(['feedback']) || (feedbackOk(now.get('feedback', ''), was.get('feedback', '')) && feedbackOk(edits.get('feedback', now.get('feedback', '')), was.get('feedback', ''))))
        && (!keys.hasAny(['appDeleted']) || can('delete'))
        && (!keys.hasAny(['ignoredProblem']) || can('fix'))
        && (!keys.hasAny(['items', 'company', 'priceBefore', 'priceAfter', 'style', 'details', 'caption', 'captionStyle']) || can('offers.create') || can('fix') || can('designs.approve'))
        // An offer is approved by someone other than the person who made it. The owner always may.
        && (!keys.hasAny(['offer', 'offerNote', 'offerBy'])
          || (can('offers.approve') && (isOwner() || isAdmin() || was.get('createdBy', '') != request.auth.uid))
          // The maker may send an offer that was sent back in again, and nothing else.
          || (can('offers.create') && was.get('createdBy', '') == request.auth.uid && was.get('offer', '') == 'Rejected'
            && now.get('offer', '') == '' && edits.get('offer', '') == '' && !keys.hasAny(['offerNote', 'offerBy'])))
        // Competitor prices are written by the engine only.
        && !keys.hasAny(['createdBy', 'createdByName', 'market']);
    }
    // The first list from before codes existed. Its first email is the owner; the others may
    // walk in once without a request. Admins can only shorten it.
    function firstList() {
      return get(/databases/$(database)/documents/config/access).data.emails;
    }
    function currentCode() {
      return get(/databases/$(database)/documents/secret/code).data.code;
    }
    function secretPath() {
      return /databases/$(database)/documents/secret/code;
    }
    // A request can only be filed with the code that is valid at that moment, so a request that
    // exists was made by someone who had the code. It stops counting after 7 days, or when the
    // owner makes a new code by hand. Accepting it must change the code in the same step, so a
    // code lets exactly one new person in and cannot be passed on.
    function goodRequest(uid) {
      let r = get(/databases/$(database)/documents/requests/$(uid)).data;
      let s = get(secretPath()).data;
      return r.createdAt > request.time - duration.value(7, 'd')
        && (!('resetAt' in s) || r.createdAt > s.resetAt)
        && r.email == request.resource.data.email
        && getAfter(secretPath()).data.code != s.code;
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'joinedAt'])
        && request.resource.data.email is string
        && (
          // Yourself, from the first list.
          (request.auth.uid == uid
            && request.resource.data.email == request.auth.token.email
            && ((request.resource.data.role == 'owner' && firstList()[0] == request.auth.token.email)
              || (request.resource.data.role == 'member' && request.auth.token.email in firstList())))
          // Someone else, by accepting their request.
          || (request.auth.uid != uid && isAdmin() && request.resource.data.role == 'member' && goodRequest(uid))
        );
      // Only the owner changes roles, never their own, and nobody becomes a second owner.
      allow update: if isOwner()
        && request.auth.uid != uid
        && resource.data.role != 'owner'
        && request.resource.data.role is string
        && request.resource.data.role != 'owner'
        && (request.resource.data.role in ['admin', 'member'] || exists(rolePath(request.resource.data.role)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      allow delete: if signedIn() && resource.data.role != 'owner'
        // Someone who manages people cannot remove another person who manages people.
        && (request.auth.uid == uid || isOwner() || (isAdmin() && !('people' in permsOf(resource.data.role))));
    }

    match /requests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // The code is checked here, on the server, so a wrong code cannot even file a request.
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'code', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.code == currentCode();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /secret/code {
      allow read: if isAdmin();
      // The owner makes a new code by hand, which also drops the requests still waiting.
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['code', 'changedAt', 'resetAt', 'lastJoin'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 16
        && (!('resetAt' in request.resource.data) || request.resource.data.resetAt is timestamp);
      // Someone who manages people can change the code only as part of accepting a new person.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code', 'changedAt', 'lastJoin'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 16
        && request.resource.data.code != resource.data.code
        && request.resource.data.lastJoin is string
        && !exists(memberPath(request.resource.data.lastJoin))
        && existsAfter(memberPath(request.resource.data.lastJoin));
    }

    match /config/access {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emails'])
        && request.resource.data.emails.size() >= 1
        && request.resource.data.emails.size() <= resource.data.emails.size()
        && request.resource.data.emails[0] == resource.data.emails[0]
        && resource.data.emails.hasAll(request.resource.data.emails);
    }
    // The roles the owner made. Everyone inside reads them to know what they may do.
    match /roles/{id} {
      allow read: if isMember();
      allow create, update: if isOwner()
        && id != 'owner'
        && request.resource.data.keys().hasOnly(['name', 'perms', 'pages'])
        && (!('pages' in request.resource.data) || (request.resource.data.pages is list
          && request.resource.data.pages.hasOnly(['offers', 'review', 'fix', 'calendar', 'posted', 'database'])))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.perms is list
        && request.resource.data.perms.size() <= 20
        && request.resource.data.perms.hasOnly(allPerms());
      allow delete: if isOwner() && !(id in ['admin', 'member']);
    }
    match /posts/{id} {
      allow read: if isMember();
      allow create: if can('offers.create')
        && request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid
        && !request.resource.data.keys().hasAny(['offer', 'offerNote', 'offerBy', 'market']);
      allow update: if isMember() && postChangeOk();
    }
    match /catalog/{id} {
      allow read, write: if isMember();
    }
    match /status/{id} {
      allow read: if isMember();
    }
  }
}
